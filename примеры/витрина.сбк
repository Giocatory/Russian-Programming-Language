// Витрина возможностей языка Сибиряк
// Демонстрирует: циклы, условия, переменные, функции, константы
пакет главный

импорт "фмт"

// Константы
конст МаксЧисло цел = 100

// Функция с параметрами
функ факториал(н цел) цел {
    если н <= 1 {
        возврат 1
    }
    возврат н * факториал(н-1)
}

// Проверка простого числа
функ этоПростое(н цел) булево {
    если н < 2 {
        возврат ложь
    }
    для i := 2; i*i <= н; i++ {
        если н%i == 0 {
            возврат ложь
        }
    }
    возврат истина
}

функ максимум(а цел, б цел) цел {
    если а > б {
        возврат а
    }
    возврат б
}

функ Главная() {
    фмт.Печать("Добро пожаловать в Сибиряк!")
    фмт.ПечатьФ("Максимальное число: %ld\n\n", МаксЧисло)

    х := 42
    у := 13
    фмт.ПечатьФ("х = %ld, у = %ld\n", х, у)
    фмт.ПечатьФ("максимум(%ld, %ld) = %ld\n\n", х, у, максимум(х, у))

    // Факториалы
    фмт.Печать("Факториалы:")
    для i := 1; i <= 10; i++ {
        фмт.ПечатьФ("  %ld! = %ld\n", i, факториал(i))
    }

    // Простые числа
    фмт.Печать("\nПростые числа до 50:")
    для i := 2; i <= 50; i++ {
        если этоПростое(i) {
            фмт.ПечатьФ("  %ld", i)
        }
    }
    фмт.Печать("")

    // Таблица умножения
    фмт.Печать("\nТаблица умножения (3x3):")
    для i := 1; i <= 3; i++ {
        для j := 1; j <= 3; j++ {
            фмт.ПечатьФ("  %ldx%ld=%ld", i, j, i*j)
        }
        фмт.Печать("")
    }

    // Перекл с условиями (аналог switch без выражения)
    оценка := 85
    фмт.ПечатьФ("\nОценка %ld — это:\n", оценка)
    перекл {
        случай оценка >= 90:
            фмт.Печать("  Отлично!")
        случай оценка >= 75:
            фмт.Печать("  Хорошо!")
        случай оценка >= 60:
            фмт.Печать("  Удовлетворительно")
        умолч:
            фмт.Печать("  Неудовлетворительно")
    }

    // Поиск кратного
    фмт.Печать("\nПоиск числа кратного 7 и 11:")
    для i := 1; i <= МаксЧисло; i++ {
        если i%7 == 0 && i%11 == 0 {
            фмт.ПечатьФ("  Найдено: %ld\n", i)
            прервать
        }
    }

    // Нечётные с продолжить
    фмт.Печать("\nНечётные числа от 1 до 20:")
    для i := 1; i <= 20; i++ {
        если i%2 == 0 {
            продолжить
        }
        фмт.ПечатьФ("  %ld", i)
    }
    фмт.Печать("")
    фмт.Печать("\n── Программа завершена успешно ──")
}
