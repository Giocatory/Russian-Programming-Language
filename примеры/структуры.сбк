// Структуры и методы — объектно-ориентированный стиль в Сибиряке
пакет главный

импорт "фмт"

// Объявление структуры
структ Прямоугольник {
    Ширина  вещ64
    Высота  вещ64
}

структ Круг {
    Радиус вещ64
}

// Метод структуры Прямоугольник
функ (п *Прямоугольник) Площадь() вещ64 {
    возврат п.Ширина * п.Высота
}

функ (п *Прямоугольник) Периметр() вещ64 {
    возврат 2 * (п.Ширина + п.Высота)
}

функ (п *Прямоугольник) Масштаб(коэф вещ64) {
    п.Ширина = п.Ширина * коэф
    п.Высота = п.Высота * коэф
}

// Метод структуры Круг
функ (к *Круг) Площадь() вещ64 {
    пер пи вещ64 = 3.14159265358979
    возврат пи * к.Радиус * к.Радиус
}

функ (к *Круг) Периметр() вещ64 {
    пер пи вещ64 = 3.14159265358979
    возврат 2 * пи * к.Радиус
}

функ Главная() {
    // Создание структур
    пр := Прямоугольник{Ширина: 10.0, Высота: 5.0}
    фмт.ПечатьФ("Прямоугольник %gx%g:\n", пр.Ширина, пр.Высота)
    фмт.ПечатьФ("  Площадь:    %g\n", пр.Площадь())
    фмт.ПечатьФ("  Периметр:   %g\n", пр.Периметр())

    пр.Масштаб(2.0)
    фмт.ПечатьФ("После масштабирования x2:\n")
    фмт.ПечатьФ("  Площадь:    %g\n", пр.Площадь())

    кр := Круг{Радиус: 7.0}
    фмт.ПечатьФ("\nКруг r=%g:\n", кр.Радиус)
    фмт.ПечатьФ("  Площадь:    %.4f\n", кр.Площадь())
    фмт.ПечатьФ("  Длина окр.: %.4f\n", кр.Периметр())
}
