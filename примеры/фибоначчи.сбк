// Числа Фибоначчи — демонстрация рекурсии и циклов
пакет главный

импорт "фмт"

// Рекурсивная функция
функ фибоначчи(н цел) цел {
    если н <= 1 {
        возврат н
    }
    возврат фибоначчи(н-1) + фибоначчи(н-2)
}

// Итеративная версия (быстрее)
функ фибоначчиИтер(н цел) цел {
    если н <= 1 {
        возврат н
    }
    пер а цел = 0
    пер б цел = 1
    для i := 2; i <= н; i++ {
        а, б = б, а+б
    }
    возврат б
}

функ Главная() {
    фмт.ПечатьФ("Числа Фибоначчи (рекурсия):\n")
    для i := 0; i < 10; i++ {
        фмт.ПечатьФ("  фиб(%d) = %d\n", i, фибоначчи(i))
    }

    фмт.ПечатьФ("\nЧисла Фибоначчи (итерация):\n")
    для i := 0; i < 15; i++ {
        фмт.ПечатьФ("  фиб(%d) = %d\n", i, фибоначчиИтер(i))
    }
}
