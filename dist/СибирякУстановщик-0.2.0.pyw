#!/usr/bin/env python3
# -*- coding: utf-8 -*-
# =============================================================
#  УСТАНОВЩИК ЯЗЫКА СИБИРЯК 0.2.0 ДЛЯ WINDOWS
#  Двойной клик — запускает графический мастер установки
#  Требуется: Python 3.8+
# =============================================================
import sys, os, base64, zipfile, io, subprocess, threading, shutil
from pathlib import Path

ВЕРСИЯ   = "0.2.0"
APPNAME  = "Сибиряк"
_ZIP_B64 = ""
ZIP_DATA = base64.b64decode(_ZIP_B64)

# ─── Системные утилиты ────────────────────────────────────────────────────────

def есть_права_администратора():
    try:
        import ctypes
        return bool(ctypes.windll.shell32.IsUserAnAdmin())
    except Exception:
        return False

def проверить_программу(имя):
    try:
        r = subprocess.run([имя, "--version"], capture_output=True, timeout=5)
        return r.returncode == 0, (r.stdout or r.stderr).decode(errors='replace').strip()
    except Exception:
        return False, ""

def проверить_python():
    return проверить_программу(sys.executable)

def проверить_rust():
    кандидаты = [
        "rustc",
        os.path.expanduser("~/.cargo/bin/rustc"),
        os.path.expandvars(r"%USERPROFILE%\.cargo\bin\rustc.exe"),
    ]
    for rustc in кандидаты:
        ок, вер = проверить_программу(rustc)
        if ок:
            return True, вер
    return False, ""

def установить_rust(cb):
    cb("Скачиваем rustup-init.exe (может занять пару минут)...", "yellow")
    try:
        import urllib.request
        url = "https://static.rust-lang.org/rustup/dist/x86_64-pc-windows-msvc/rustup-init.exe"
        tmp = os.path.join(os.environ.get("TEMP", r"C:\Temp"), "rustup-init.exe")
        urllib.request.urlretrieve(url, tmp)
        cb("Запускаем установщик Rust...", "yellow")
        r = subprocess.run([tmp, "-y", "--default-toolchain", "stable"],
                           capture_output=True, timeout=600)
        if r.returncode == 0:
            cb("Rust успешно установлен!", "green")
            return True
        cb(f"Ошибка установки Rust (код {r.returncode})", "red")
        return False
    except Exception as ex:
        cb(f"Не удалось установить Rust: {ex}", "red")
        return False

# ─── Установка ────────────────────────────────────────────────────────────────

def распаковать(целевая, cb):
    cb(f"Распаковываем файлы в {целевая}...", "white")
    zf = zipfile.ZipFile(io.BytesIO(ZIP_DATA))
    n = 0
    for имя in zf.namelist():
        новое = имя[len("Сибиряк/"):] if имя.startswith("Сибиряк/") else имя
        if not новое:
            continue
        dst = os.path.join(целевая, новое)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if not имя.endswith("/"):
            with zf.open(имя) as src, open(dst, "wb") as f:
                f.write(src.read())
            n += 1
    cb(f"Извлечено {n} файлов", "green")

def добавить_в_path(папка, cb):
    if sys.platform != "win32":
        cb("PATH: только для Windows", "yellow"); return
    try:
        import winreg
        KEY = r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment"
        к = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, KEY, 0,
                           winreg.KEY_READ | winreg.KEY_WRITE)
        старый, _ = winreg.QueryValueEx(к, "Path")
        if папка.lower() not in старый.lower():
            winreg.SetValueEx(к, "Path", 0, winreg.REG_EXPAND_SZ, старый + ";" + папка)
            try:
                import ctypes
                ctypes.windll.user32.SendMessageW(0xFFFF, 0x001A, 0, "Environment")
            except Exception:
                pass
            cb(f"Добавлено в PATH: {папка}", "green")
        else:
            cb("Путь уже присутствует в PATH", "white")
        winreg.CloseKey(к)
    except PermissionError:
        cb("Нет прав для записи в реестр (требуется администратор)", "yellow")
    except Exception as ex:
        cb(f"Ошибка PATH: {ex}", "yellow")

def зарегистрировать_расширение(папка, cb):
    if sys.platform != "win32":
        cb("Расширения: только для Windows", "yellow"); return
    try:
        import winreg
        cmd = os.path.join(папка, "сибиряк.cmd")
        записи = [
            (winreg.HKEY_CLASSES_ROOT, ".сбк",                                    "",  "СибирякФайл"),
            (winreg.HKEY_CLASSES_ROOT, "СибирякФайл",                             "",  "Файл Сибиряк (.сбк)"),
            (winreg.HKEY_CLASSES_ROOT, r"СибирякФайл\shell\open\command",         "",  f'"{cmd}" "%1"'),
            (winreg.HKEY_CLASSES_ROOT, r"СибирякФайл\shell\compile",              "",  "Скомпилировать"),
            (winreg.HKEY_CLASSES_ROOT, r"СибирякФайл\shell\compile\command",      "",  f'cmd /k "{cmd}" "%1" & pause'),
            (winreg.HKEY_CLASSES_ROOT, r"СибирякФайл\shell\run",                  "",  "Скомпилировать и запустить"),
            (winreg.HKEY_CLASSES_ROOT, r"СибирякФайл\shell\run\command",          "",  f'cmd /k "{cmd}" запустить "%1" & pause'),
        ]
        for куст, ключ, имя, значение in записи:
            with winreg.CreateKey(куст, ключ) as к:
                winreg.SetValueEx(к, имя, 0, winreg.REG_SZ, значение)
        # Уведомляем Проводник
        try:
            import ctypes
            ctypes.windll.shell32.SHChangeNotify(0x08000000, 0, 0, 0)
        except Exception:
            pass
        cb("Расширение .сбк зарегистрировано", "green")
    except Exception as ex:
        cb(f"Ошибка регистрации расширения: {ex}", "yellow")

def зарегистрировать_программу(папка, cb):
    if sys.platform != "win32":
        return
    try:
        import winreg
        KEY = r"Software\Microsoft\Windows\CurrentVersion\Uninstall\Сибиряк"
        with winreg.CreateKey(winreg.HKEY_LOCAL_MACHINE, KEY) as к:
            winreg.SetValueEx(к, "DisplayName",     0, winreg.REG_SZ,    f"Сибиряк {ВЕРСИЯ}")
            winreg.SetValueEx(к, "DisplayVersion",  0, winreg.REG_SZ,    ВЕРСИЯ)
            winreg.SetValueEx(к, "Publisher",       0, winreg.REG_SZ,    "Сибиряк Project")
            winreg.SetValueEx(к, "InstallLocation", 0, winreg.REG_SZ,    папка)
            winreg.SetValueEx(к, "UninstallString", 0, winreg.REG_SZ,
                              f'python "{os.path.join(папка, "удалить.py")}"')
            winreg.SetValueEx(к, "NoModify",        0, winreg.REG_DWORD, 1)
        cb("Программа зарегистрирована (Программы и компоненты)", "green")
    except Exception as ex:
        cb(f"Ошибка регистрации: {ex}", "yellow")

def создать_деинсталлятор(папка):
    скрипт = (
        '#!/usr/bin/env python3\n'
        '# -*- coding: utf-8 -*-\n'
        'import os, sys, shutil, subprocess\n'
        'ПАПКА = ' + repr(папка) + '\n'
        'try:\n'
        '    import tkinter as tk\n'
        '    from tkinter import messagebox\n'
        '    root = tk.Tk(); root.withdraw()\n'
        '    if messagebox.askyesno("Удаление Сибиряк",\n'
        '            f"Удалить Сибиряк и все файлы из:\\n{ПАПКА}?"):\n'
        '        shutil.rmtree(ПАПКА, ignore_errors=True)\n'
        '        try:\n'
        '            import winreg\n'
        '            for h, k in [\n'
        '                (winreg.HKEY_CLASSES_ROOT, ".сбк"),\n'
        '                (winreg.HKEY_CLASSES_ROOT, "СибирякФайл"),\n'
        '                (winreg.HKEY_LOCAL_MACHINE,\n'
        '                 r"Software\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\Сибиряк"),\n'
        '            ]:\n'
        '                try: winreg.DeleteKey(h, k)\n'
        '                except: pass\n'
        '        except: pass\n'
        '        messagebox.showinfo("Готово", "Сибиряк удалён.")\n'
        'except ImportError:\n'
        '    shutil.rmtree(ПАПКА, ignore_errors=True)\n'
        '    print("Сибиряк удалён.")\n'
    )
    Path(os.path.join(папка, "удалить.py")).write_text(скрипт, encoding="utf-8")

def создать_лаунчеры(папка, cb):
    # .cmd для CMD
    (Path(папка) / "сибиряк.cmd").write_text(
        '@echo off\r\n'
        'rem Компилятор языка Сибиряк\r\n'
        'python "%~dp0компилятор\\сибиряк.py" %*\r\n',
        encoding='cp1251'
    )
    # .ps1 для PowerShell
    (Path(папка) / "сибиряк.ps1").write_text(
        '# Компилятор языка Сибиряк (PowerShell)\r\n'
        '$dir = Split-Path -Parent $MyInvocation.MyCommand.Path\r\n'
        'python "$dir\\компилятор\\сибиряк.py" @args\r\n',
        encoding='utf-8'
    )
    cb("Лаунчеры сибиряк.cmd и сибиряк.ps1 созданы", "green")

# ─── GUI ──────────────────────────────────────────────────────────────────────

try:
    import tkinter as tk
    from tkinter import ttk, messagebox, filedialog
    HAS_TK = True
except ImportError:
    HAS_TK = False


class УстановщикОкно:
    ФОН         = "#1a1a2e"
    ЗАГОЛОВОК   = "#16213e"
    АКЦЕНТ      = "#e94560"
    ТЕКСТ       = "#a8b2d8"
    ДИМ         = "#64748b"
    ПОЛЕ        = "#0f3460"
    ЗЕЛЁНЫЙ_FG  = "#3fb950"

    def __init__(self):
        self.root = tk.Tk()
        self.root.title(f"Установка Сибиряк {ВЕРСИЯ}")
        self.root.geometry("650x580")
        self.root.resizable(False, False)
        self.root.configure(bg=self.ФОН)
        self._gui()

    def _gui(self):
        # Шапка
        ш = tk.Frame(self.root, bg=self.ЗАГОЛОВОК, pady=18)
        ш.pack(fill=tk.X)
        tk.Label(ш, text="🌲  СИБИРЯК", font=("Consolas", 30, "bold"),
                 fg=self.АКЦЕНТ, bg=self.ЗАГОЛОВОК).pack()
        tk.Label(ш, text=f"Русскоязычный язык программирования  •  v{ВЕРСИЯ}",
                 font=("Segoe UI", 11), fg=self.ТЕКСТ, bg=self.ЗАГОЛОВОК).pack(pady=(2, 0))
        tk.Label(ш, text="Бэкенд: Rust  ·  Аналог Golang  ·  Расширение: .сбк",
                 font=("Segoe UI", 9), fg=self.ДИМ, bg=self.ЗАГОЛОВОК).pack()

        # Тело
        т = tk.Frame(self.root, bg=self.ФОН, padx=28, pady=10)
        т.pack(fill=tk.BOTH, expand=True)

        # Папка установки
        tk.Label(т, text="Папка установки:", font=("Segoe UI", 10),
                 fg=self.ТЕКСТ, bg=self.ФОН).pack(anchor=tk.W, pady=(8, 3))
        р = tk.Frame(т, bg=self.ФОН)
        р.pack(fill=tk.X)
        дефолт = os.path.join(
            os.environ.get("ProgramFiles", r"C:\Program Files"), "Сибиряк")
        self.папка_var = tk.StringVar(value=дефолт)
        tk.Entry(р, textvariable=self.папка_var, font=("Consolas", 10),
                 bg=self.ПОЛЕ, fg="#e2e8f0", insertbackground="white",
                 relief=tk.FLAT, bd=6).pack(side=tk.LEFT, fill=tk.X, expand=True)
        tk.Button(р, text=" … ", font=("Segoe UI", 9),
                  bg=self.АКЦЕНТ, fg="white", relief=tk.FLAT, padx=7, cursor="hand2",
                  command=self._выбрать).pack(side=tk.LEFT, padx=(6, 0))

        # Опции
        tk.Label(т, text="Параметры:", font=("Segoe UI", 10),
                 fg=self.ТЕКСТ, bg=self.ФОН).pack(anchor=tk.W, pady=(14, 4))
        self.opt_path = tk.BooleanVar(value=True)
        self.opt_ext  = tk.BooleanVar(value=True)
        self.opt_menu = tk.BooleanVar(value=True)
        self.opt_rust = tk.BooleanVar(value=True)
        for var, label in [
            (self.opt_path, "  ✓  Добавить в системный PATH  (команда «сибиряк» из любой папки)"),
            (self.opt_ext,  "  ✓  Ассоциировать файлы .сбк  (правая кнопка → Скомпилировать)"),
            (self.opt_menu, "  ✓  Добавить в меню Пуск"),
            (self.opt_rust, "  ✓  Установить Rust автоматически, если не найден"),
        ]:
            tk.Checkbutton(т, text=label, variable=var,
                           font=("Segoe UI", 10), fg=self.ТЕКСТ, bg=self.ФОН,
                           selectcolor=self.ПОЛЕ, activebackground=self.ФОН,
                           activeforeground="#e2e8f0").pack(anchor=tk.W)

        # Лог
        tk.Label(т, text="Журнал установки:", font=("Segoe UI", 9),
                 fg=self.ДИМ, bg=self.ФОН).pack(anchor=tk.W, pady=(14, 3))
        лф = tk.Frame(т, bg="#0d1117")
        лф.pack(fill=tk.BOTH, expand=True)
        self.лог = tk.Text(лф, height=7, font=("Consolas", 9),
                           bg="#0d1117", fg="#58a6ff",
                           relief=tk.FLAT, state=tk.DISABLED, wrap=tk.WORD)
        sb = ttk.Scrollbar(лф, command=self.лог.yview)
        self.лог.configure(yscrollcommand=sb.set)
        self.лог.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5, pady=5)
        sb.pack(side=tk.RIGHT, fill=tk.Y)
        for тег, цвет in [("green","#3fb950"),("yellow","#d29922"),
                           ("red","#f85149"),("white","#c9d1d9")]:
            self.лог.tag_config(тег, foreground=цвет)

        # Прогресс
        self.прогресс = ttk.Progressbar(т, mode="indeterminate", length=594)
        self.прогресс.pack(fill=tk.X, pady=(6, 0))

        # Кнопки
        н = tk.Frame(self.root, bg=self.ЗАГОЛОВОК, pady=14)
        н.pack(fill=tk.X)
        self.кноп = tk.Button(
            н, text="   🚀   УСТАНОВИТЬ   ",
            font=("Segoe UI", 12, "bold"),
            bg=self.АКЦЕНТ, fg="white", relief=tk.FLAT,
            padx=22, pady=9, cursor="hand2",
            command=self._начать)
        self.кноп.pack(side=tk.RIGHT, padx=22)
        tk.Button(н, text="Отмена", font=("Segoe UI", 10),
                  bg="#374151", fg="#9ca3af", relief=tk.FLAT,
                  padx=14, pady=9, cursor="hand2",
                  command=self.root.quit).pack(side=tk.RIGHT, padx=4)

    def _выбрать(self):
        п = filedialog.askdirectory(title="Выберите папку для установки Сибиряк")
        if п:
            self.папка_var.set(п.replace("/", "\\"))

    def _пишем(self, текст, цвет="white"):
        def _u():
            self.лог.configure(state=tk.NORMAL)
            self.лог.insert(tk.END, f"  › {текст}\n", цвет)
            self.лог.see(tk.END)
            self.лог.configure(state=tk.DISABLED)
        self.root.after(0, _u)

    def _начать(self):
        self.кноп.configure(state=tk.DISABLED, text="Установка…")
        self.прогресс.start(12)
        threading.Thread(target=self._установить, daemon=True).start()

    def _установить(self):
        try:
            папка = self.папка_var.get()
            self._пишем(f"Целевая папка: {папка}")

            _, вер_py = проверить_python()
            self._пишем(f"Python {вер_py} — OK", "green")

            ок_rust, вер_rust = проверить_rust()
            if ок_rust:
                self._пишем(f"Rust {вер_rust} — OK", "green")
            elif self.opt_rust.get():
                установить_rust(self._пишем)
            else:
                self._пишем("Rust не найден. Установите позже: https://rustup.rs", "yellow")

            os.makedirs(папка, exist_ok=True)
            распаковать(папка, self._пишем)
            создать_лаунчеры(папка, self._пишем)

            if self.opt_path.get():
                добавить_в_path(папка, self._пишем)
            if self.opt_ext.get():
                зарегистрировать_расширение(папка, self._пишем)
            зарегистрировать_программу(папка, self._пишем)
            создать_деинсталлятор(папка)

            if self.opt_menu.get():
                try:
                    меню = os.path.join(os.environ.get("APPDATA", ""),
                                        "Microsoft", "Windows", "Start Menu",
                                        "Programs", "Сибиряк")
                    os.makedirs(меню, exist_ok=True)
                    bat = os.path.join(меню, "Сибиряк.bat")
                    with open(bat, "w") as f:
                        f.write(f'@echo off\r\npython "{os.path.join(папка,"компилятор","сибиряк.py")}" %*\r\n')
                    self._пишем("Ярлыки в меню Пуск добавлены", "green")
                except Exception as ex:
                    self._пишем(f"Ярлыки: {ex}", "yellow")

            self._пишем("")
            self._пишем("══════════════════════════════════════", "green")
            self._пишем(f"  Сибиряк {ВЕРСИЯ} успешно установлен!", "green")
            self._пишем(f"  Папка:   {папка}", "green")
            self._пишем("  Команда: сибиряк --помощь", "green")
            self._пишем("══════════════════════════════════════", "green")

            def _готово():
                self.прогресс.stop()
                self.кноп.configure(text="✓  Установлено!", bg="#238636", state=tk.DISABLED)
                messagebox.showinfo(
                    "Сибиряк установлен!",
                    f"Сибиряк {ВЕРСИЯ} успешно установлен!\n\n"
                    f"Папка: {папка}\n\n"
                    "Откройте новую командную строку и введите:\n"
                    "  сибиряк --помощь\n"
                    "  сибиряк запустить примеры\\витрина.сбк"
                )
            self.root.after(0, _готово)

        except Exception as ex:
            import traceback
            self._пишем(f"Критическая ошибка: {ex}", "red")
            self._пишем(traceback.format_exc(), "red")
            self.root.after(0, lambda: (
                self.прогресс.stop(),
                self.кноп.configure(state=tk.NORMAL,
                                    text="   🚀   УСТАНОВИТЬ   ")
            ))

    def запустить(self):
        self.root.mainloop()


def консольная_установка():
    print(f"\n  ╔═══════════════════════════════════════╗")
    print(f"  ║  Установщик Сибиряк {ВЕРСИЯ}             ║")
    print(f"  ╚═══════════════════════════════════════╝\n")
    default = os.path.join(os.environ.get("ProgramFiles", r"C:\Program Files"), "Сибиряк")
    папка = input(f"  Папка установки [{default}]: ").strip() or default
    cb = lambda m, c: print(f"  {m}")
    _, вер = проверить_python()
    print(f"  Python: {вер}")
    ок, вер = проверить_rust()
    if ок:
        print(f"  Rust:   {вер}")
    else:
        установить_rust(cb)
    os.makedirs(папка, exist_ok=True)
    распаковать(папка, cb)
    создать_лаунчеры(папка, cb)
    добавить_в_path(папка, cb)
    зарегистрировать_расширение(папка, cb)
    зарегистрировать_программу(папка, cb)
    создать_деинсталлятор(папка)
    print(f"\n  ✓ Сибиряк установлен в {папка}")
    print(f"    Откройте новую командную строку:")
    print(f"    сибиряк --помощь")
    input("\n  Нажмите Enter для выхода...")


if __name__ == "__main__":
    # Запрашиваем права администратора на Windows
    if sys.platform == "win32" and not есть_права_администратора():
        try:
            import ctypes
            ctypes.windll.shell32.ShellExecuteW(
                None, "runas", sys.executable, __file__, None, 1)
            sys.exit(0)
        except Exception:
            pass

    if HAS_TK:
        УстановщикОкно().запустить()
    else:
        консольная_установка()
